{
  "name": "vscode-ohm",
  "displayName": "Ohm-JS Language",
  "description": "Unofficial ohm-js language support for vscode",
  "version": "0.6.0",
  "license": "MIT",
  "author": {
    "name": "Jerry wang",
    "email": "x.jerry.wang@gmail.com"
  },
  "repository": {
    "url": "https://github.com/0x-jerry/vscode-ohm"
  },
  "publisher": "fantasy",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "ohm",
    "ohm-js"
  ],
  "icon": "resources/logo.png",
  "main": "./dist/node/extension.js",
  "browser": "./dist/web/extension.js",
  "activationEvents": [
    "workspaceContains:*.ohm"
  ],
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ohm",
        "aliases": [
          "Ohm",
          "ohm"
        ],
        "extensions": [
          ".ohm"
        ],
        "configuration": "./settings/ohm.language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ohm",
        "scopeName": "source.ohm",
        "path": "./settings/ohm.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Ohm-js settings",
      "properties": {
        "ohm-js.validator": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "match": {
                "type": "array",
                "description": "Glob pattern",
                "items": {
                  "type": "string"
                }
              },
              "grammar": {
                "type": "string",
                "description": "Ohm grammar that used to validate the matched file, relative path"
              }
            }
          },
          "default": []
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "tsup",
    "build": "tsup",
    "dev": "tsup --watch",
    "publish": "vsce publish --no-dependencies",
    "generate:ohm": "ohm generateBundles src/grammar/*.ohm -t -e",
    "release": "x-release --publish false"
  },
  "devDependencies": {
    "@0x-jerry/utils": "^6.0.0",
    "@0x-jerry/x-release": "^2.4.1",
    "@ohm-js/cli": "^2.0.1",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^25.0.10",
    "@types/vscode": "^1.60.0",
    "@vscode/vsce": "^3.7.1",
    "micromatch": "^4.0.8",
    "ohm-js": "^17.3.0",
    "pathe": "^2.0.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "ufo": "^1.6.3",
    "vitest": "^4.0.18",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  }
}